#!/bin/sh
set -e

UNIT=lywsd02-clock-sync.service

# Stopped on upgrade too: the new files are unpacked under a running bundle otherwise.
if [ -d /run/systemd/system ]; then
    case "$1" in
    remove|upgrade|deconfigure)
        systemctl stop "$UNIT" >/dev/null 2>&1 || true
        ;;
    esac
    if [ "$1" = remove ]; then
        systemctl disable "$UNIT" >/dev/null 2>&1 || true
    fi
fi

exit 0

* text=auto

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.service text eol=lf
# Debian maintainer scripts run under /bin/sh, which rejects CRLF.
packaging/linux/* text eol=lf
*.ico binary
*.png binary
# cmd.exe and Windows PowerShell 5.1 expect CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
